# Copy to .env and edit. Every value here is optional except in production, where
# PUBLIC_URL and SESSION_SECRET should always be set.

# ── Server ────────────────────────────────────────────────────────────
PORT=8081
HOST=0.0.0.0
# Your real origin. Cookies become Secure automatically when this is https://
PUBLIC_URL=http://localhost:8081
# Set to true only when running behind a reverse proxy you control (nginx, Caddy, Cloudflare).
TRUST_PROXY=false
# Long random string; keeps signed cookies valid across restarts.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Storage ───────────────────────────────────────────────────────────
DATABASE_PATH=data/adventure.db
UPLOAD_DIR=data/uploads

# ── Optional: Discord sign-in ─────────────────────────────────────────
# Leave blank to hide the Discord button entirely.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match the redirect URI registered in your Discord application.
DISCORD_REDIRECT_URI=http://localhost:8081/api/auth/discord/callback

# ── Optional: email (password resets) ─────────────────────────────────
# Leave blank to disable password reset by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DTEmpire Adventure <no-reply@example.com>
