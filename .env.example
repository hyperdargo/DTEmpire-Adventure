# ── DTEmpire Adventure Web App Configuration ──
# Copy to .env and fill in your values
# Never commit .env to version control!

# ── Flask Secret (required in production) ──
WEB_SECRET_KEY=your-random-secret-key-here

# ── Discord OAuth2 (required for login) ──
# Get from https://discord.com/developers/applications
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=https://your-domain.com/callback
DISCORD_HOME_GUILD_ID=your-home-guild-id

# ── Discord Webhook (optional - for web→Discord notifications) ──
DISCORD_WEBHOOK_URL=

# ── Email OTP / SMTP (required for email login) ──
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=DTEmpire <no-reply@your-domain.com>

# ── R2 Backups (optional - Cloudflare R2 / S3-compatible) ──
ADVENTURE_R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
ADVENTURE_R2_ACCESS_KEY_ID=your-access-key
ADVENTURE_R2_SECRET_ACCESS_KEY=your-secret-key
ADVENTURE_R2_BUCKET=adventure-backups
ADVENTURE_R2_BACKUP_MIN_INTERVAL=300
ADVENTURE_BACKUP_FERNET_KEY=your-fernet-key-32-bytes-base64

# ── Web Server ──
WEB_PORT=8081
WEB_RELOADER=0