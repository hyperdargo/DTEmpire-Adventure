{
  "name": "dtempire-adventure",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "DTEmpire Adventure: a persistent multiplayer browser RPG, installable as a PWA.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/main.ts & vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "import:legacy": "node scripts/import-legacy.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "qa": "node scripts/qa-capture.ts",
    "balance": "node scripts/balance-sim.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@fastify/websocket": "^11.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/marcellus-sc": "^5.3.0",
    "@tanstack/react-query": "^5.103.1",
    "fastify": "^5.12.5",
    "lucide-react": "^1.47.0",
    "nodemailer": "^10.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  }
}
